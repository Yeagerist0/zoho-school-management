[
 {
  "name": "wfConfirmAdmission",
  "file": "automation",
  "ret": "void",
  "category": "automation",
  "params": [
   {
    "name": "leadId",
    "type": "int"
   }
  ],
  "workflow": "// Leads : Edit\nlead = zoho.crm.getRecordById(\"Leads\", leadId);\nif(ifnull(lead.get(\"Lead_Status\"), \"\") == \"Admission Confirmed\")\n{\n    standalone.confirmAdmission(leadId);\n}\n",
  "module": "Leads",
  "trigger": "Edit"
 },
