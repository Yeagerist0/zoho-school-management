 {
  "name": "wfProcessLeaveApproval",
  "file": "automation",
  "ret": "void",
  "category": "automation",
  "params": [
   {
    "name": "leaveId",
    "type": "int"
   }
  ],
  "workflow": "// Leave_Requests : Edit\nlv = zoho.crm.getRecordById(\"Leave_Requests\", leaveId);\nst = ifnull(lv.get(\"Status\"), \"\").toString();\nif(st == \"Approved\" || st == \"Rejected\")\n{\n    standalone.processLeaveApproval(leaveId);\n}\n",
  "module": "Leave_Requests",
  "trigger": "Edit"
 }
