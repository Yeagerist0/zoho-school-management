/* ============================================================================
 * ZOHO CREATOR - PARENT PORTAL : DATA FUNCTIONS
 *
 * Every function here follows the same three steps:
 *      1. assertStudentAccess()  - authorise, or return empty
 *      2. pull live from CRM     - Creator stores no copy of this data
 *      3. return a small Map     - the page renders from it
 *
 * Rendering: these are called from Deluge HTML snippets on Creator PAGES. The
 * snippet builds markup from the returned Map; there are no Creator reports over
 * duplicated CRM data anywhere in this app.
 *
 * Cost control: each page is ONE COQL call, selecting only the columns shown.
 * Percentages, totals and ranks are read as stored values because CRM already
 * maintains them - the portal never recomputes a year of history to draw a card.
 * ========================================================================== */


/* ----------------------------------------------------------------------------
 * portal.getDashboard - the landing card for one child
 * -------------------------------------------------------------------------- */
map portal.getDashboard(string studentId)
{
    out = Map();
    out.put("ok", false);

    access = portal.assertStudentAccess(studentId);
    if(access.size() == 0)
    {
        out.put("message", "You are not authorised to view this student.");
        return out;
    }

    rows = portal.coql(
        "select id, Student_ID, Student_Name, DOB, Gender, Blood_Group, Admission_Date, Status, " +
        "Current_Class_Section.Name, Current_Class_Section.Class.Class_Name, Current_Class_Section.Section, " +
        "Current_Class_Section.Class_Teacher.Name, Current_Class_Section.Room_No, " +
        "Current_Enrollment.Roll_No, Current_Enrollment.Attendance_Percent, " +
        "Current_Enrollment.Days_Present, Current_Enrollment.Days_Marked " +
        "from Students where id = " + studentId);

    if(rows.size() == 0)
    {
        out.put("message", "Student record not available.");
        return out;
    }
    s = rows.get(0);

    p = Map();
    p.put("code",        ifnull(s.get("Student_ID"), ""));
    p.put("name",        ifnull(s.get("Student_Name"), ""));
    p.put("dob",         ifnull(s.get("DOB"), ""));
    p.put("gender",      ifnull(s.get("Gender"), ""));
    p.put("bloodGroup",  ifnull(s.get("Blood_Group"), ""));
    p.put("admitted",    ifnull(s.get("Admission_Date"), ""));
    p.put("status",      ifnull(s.get("Status"), ""));

    sec = s.get("Current_Class_Section");
    if(!isNull(sec))
    {
        p.put("class",       ifnull(sec.get("Class").get("Class_Name"), ""));
        p.put("section",     ifnull(sec.get("Section"), ""));
        p.put("room",        ifnull(sec.get("Room_No"), ""));
        p.put("classTeacher", if(isNull(sec.get("Class_Teacher")), "-", ifnull(sec.get("Class_Teacher").get("Name"), "-")));
    }

    en = s.get("Current_Enrollment");
    if(!isNull(en))
    {
        p.put("rollNo",       ifnull(en.get("Roll_No"), ""));
        p.put("attendancePct", ifnull(en.get("Attendance_Percent"), 0));
        p.put("daysPresent",  ifnull(en.get("Days_Present"), 0));
        p.put("daysMarked",   ifnull(en.get("Days_Marked"), 0));
    }

    out.put("ok", true);
    out.put("profile", p);
    return out;
}


/* ----------------------------------------------------------------------------
 * portal.getSubjectsAndTeachers - who teaches this child, and what
 * Student -> Enrollment -> Class_Section -> Subject_Allocations
 * -------------------------------------------------------------------------- */
list portal.getSubjectsAndTeachers(string studentId)
{
    out    = List();
    access = portal.assertStudentAccess(studentId);
    if(access.size() == 0 || access.get("section").toString() == "")
    {
        return out;
    }

    rows = portal.coql(
        "select Subject.Subject_Name, Subject.Subject_Code, Teacher.Name, Teacher.Email, Periods_Per_Week " +
        "from Subject_Allocations where Class_Section = " + access.get("section"));

    for each r in rows
    {
        m = Map();
        m.put("subject", ifnull(r.get("Subject").get("Subject_Name"), ""));
        m.put("code",    ifnull(r.get("Subject").get("Subject_Code"), ""));
        m.put("teacher", if(isNull(r.get("Teacher")), "-", ifnull(r.get("Teacher").get("Name"), "-")));
        m.put("periods", ifnull(r.get("Periods_Per_Week"), ""));
        out.add(m);
    }
    return out;
}


/* ----------------------------------------------------------------------------
 * portal.getAttendance - one month at a time
 * Args: studentId, monthStart (date, first of the month)
 * Returns: Map { summary : {present, absent, late, leave, pct, ytdPct}, days : list }
 *
 * Paging by month keeps the payload at ~30 rows however long the year runs.
 * -------------------------------------------------------------------------- */
map portal.getAttendance(string studentId, date monthStart)
{
    out = Map();
    out.put("ok", false);
    out.put("days", List());

    access = portal.assertStudentAccess(studentId);
    if(access.size() == 0)
    {
        out.put("message", "Not authorised.");
        return out;
    }

    monthEnd = monthStart.addMonth(1).subDay(1);

    rows = portal.coql(
        "select Attendance_Date, Status, Remarks from Attendance " +
        "where Student = " + studentId +
        " and Attendance_Date >= '" + monthStart.toString("yyyy-MM-dd") + "'" +
        " and Attendance_Date <= '" + monthEnd.toString("yyyy-MM-dd") + "'" +
        " order by Attendance_Date asc");

    present = 0; absent = 0; late = 0; leave = 0; half = 0;
    days    = List();

    for each r in rows
    {
        st = ifnull(r.get("Status"), "").toString();
        if(st == "Present")             { present = present + 1; }
        else if(st == "Absent")         { absent  = absent + 1;  }
        else if(st == "Late")           { late    = late + 1;    }
        else if(st == "Half Day")       { half    = half + 1;    }
        else if(st == "Approved Leave") { leave   = leave + 1;   }

        d = Map();
        d.put("date",    r.get("Attendance_Date"));
        d.put("status",  st);
        d.put("remarks", ifnull(r.get("Remarks"), ""));
        days.add(d);
    }

    marked = rows.size();
    pct    = 0.0;
    if(marked > 0)
    {
        pct = round((present + late + leave + (half * 0.5)) * 100 / marked, 2);
    }

    summary = Map();
    summary.put("present", present);
    summary.put("absent",  absent);
    summary.put("late",    late);
    summary.put("halfDay", half);
    summary.put("leave",   leave);
    summary.put("marked",  marked);
    summary.put("monthPct", pct);

    // Year-to-date figure is READ, not recomputed - CRM maintains it.
    if(access.get("enrollmentId").toString() != "")
    {
        en = portal.coql("select Attendance_Percent, Days_Present, Days_Marked from Enrollments where id = " + access.get("enrollmentId"));
        if(en.size() > 0)
        {
            summary.put("ytdPct",         ifnull(en.get(0).get("Attendance_Percent"), 0));
            summary.put("ytdDaysPresent", ifnull(en.get(0).get("Days_Present"), 0));
            summary.put("ytdDaysMarked",  ifnull(en.get(0).get("Days_Marked"), 0));
        }
    }

    out.put("ok", true);
    out.put("summary", summary);
    out.put("days", days);
    return out;
}


/* ----------------------------------------------------------------------------
 * portal.getExamResults
 * Only exams with Results_Published = true are ever visible - the school
 * controls the release date, not the portal.
 * -------------------------------------------------------------------------- */
map portal.getExamResults(string studentId)
{
    out = Map();
    out.put("ok", false);
    out.put("exams", List());

    access = portal.assertStudentAccess(studentId);
    if(access.size() == 0)
    {
        out.put("message", "Not authorised.");
        return out;
    }

    // Published exam summaries for this child.
    summaries = portal.coql(
        "select Examination.id, Examination.Exam_Name, Examination.Exam_Type, Examination.Start_Date, " +
        "Total_Obtained, Total_Max, Percentage, Overall_Grade, Result, Class_Rank, Section_Rank, Subjects_Failed " +
        "from Exam_Results where Student = " + studentId +
        " and Examination.Results_Published = true order by Examination.Start_Date desc limit 20");

    if(summaries.size() == 0)
    {
        out.put("ok", true);
        out.put("message", "No results have been published yet.");
        return out;
    }

    // All subject marks for those exams in ONE call, then grouped in memory -
    // not one call per exam.
    examIds = List();
    for each s in summaries
    {
        examIds.add(s.get("Examination").get("id").toString());
    }
    marks = portal.coql(
        "select Examination.id, Subject.Subject_Name, Marks_Obtained, Max_Marks, Grade, Result, Is_Absent " +
        "from Marks where Student = " + studentId +
        " and Examination in (" + examIds.toString(",") + ") limit 200");

    byExam = Map();
    for each m in marks
    {
        eid = m.get("Examination").get("id").toString();
        lst = List();
        if(byExam.containKey(eid)) { lst = byExam.get(eid); }
        row = Map();
        row.put("subject",  if(isNull(m.get("Subject")), "", ifnull(m.get("Subject").get("Subject_Name"), "")));
        row.put("obtained", if(ifnull(m.get("Is_Absent"), false), "AB", ifnull(m.get("Marks_Obtained"), 0)));
        row.put("max",      ifnull(m.get("Max_Marks"), 0));
        row.put("grade",    ifnull(m.get("Grade"), ""));
        row.put("result",   ifnull(m.get("Result"), ""));
        lst.add(row);
        byExam.put(eid, lst);
    }

    exams = List();
    for each s in summaries
    {
        eid = s.get("Examination").get("id").toString();
        e = Map();
        e.put("examName",  ifnull(s.get("Examination").get("Exam_Name"), ""));
        e.put("examType",  ifnull(s.get("Examination").get("Exam_Type"), ""));
        e.put("date",      ifnull(s.get("Examination").get("Start_Date"), ""));
        e.put("obtained",  ifnull(s.get("Total_Obtained"), 0));
        e.put("max",       ifnull(s.get("Total_Max"), 0));
        e.put("percent",   ifnull(s.get("Percentage"), 0));
        e.put("grade",     ifnull(s.get("Overall_Grade"), ""));
        e.put("result",    ifnull(s.get("Result"), ""));
        e.put("classRank", ifnull(s.get("Class_Rank"), "-"));
        e.put("sectionRank", ifnull(s.get("Section_Rank"), "-"));
        e.put("failed",    ifnull(s.get("Subjects_Failed"), 0));
        e.put("subjects",  ifnull(byExam.get(eid), List()));
        exams.add(e);
    }

    out.put("ok", true);
    out.put("exams", exams);
    return out;
}


/* ----------------------------------------------------------------------------
 * portal.getFeeStatus - summary + installment ladder + payment history
 * Two calls, both bounded. Amounts come straight from CRM's maintained fields,
 * so the portal and the accounts desk can never show different numbers.
 * -------------------------------------------------------------------------- */
map portal.getFeeStatus(string studentId)
{
    out = Map();
    out.put("ok", false);

    access = portal.assertStudentAccess(studentId);
    if(access.size() == 0)
    {
        out.put("message", "Not authorised.");
        return out;
    }

    fees = portal.coql(
        "select id, Academic_Year.Name, Total_Fee, Concession_Amount, Amount_Paid, " +
        "Status, Next_Due_Date, Next_Due_Amount " +
        "from Student_Fees where Student = " + studentId + " order by Academic_Year.Start_Date desc limit 5");

    if(fees.size() == 0)
    {
        out.put("ok", true);
        out.put("message", "No fee record has been raised yet.");
        return out;
    }

    current  = fees.get(0);
    feeId    = current.get("id").toString();
    total    = ifnull(current.get("Total_Fee"), 0).toDecimal();
    conc     = ifnull(current.get("Concession_Amount"), 0).toDecimal();
    paid     = ifnull(current.get("Amount_Paid"), 0).toDecimal();

    summary = Map();
    summary.put("year",        if(isNull(current.get("Academic_Year")), "", current.get("Academic_Year").get("Name")));
    summary.put("totalFee",    total);
    summary.put("concession",  conc);
    summary.put("netPayable",  total - conc);
    summary.put("collected",   paid);
    summary.put("outstanding", (total - conc) - paid);
    summary.put("status",      ifnull(current.get("Status"), ""));
    summary.put("nextDueDate", ifnull(current.get("Next_Due_Date"), "-"));
    summary.put("nextDueAmt",  ifnull(current.get("Next_Due_Amount"), 0));

    installments = portal.coql(
        "select Installment_No, Due_Date, Amount_Due, Amount_Paid, Status " +
        "from Fee_Installments where Student_Fee = " + feeId + " order by Installment_No asc limit 20");

    payments = portal.coql(
        "select Receipt_No, Payment_Date, Amount, Mode, Transaction_Ref, Status " +
        "from Payments where Student_Fee = " + feeId + " and Status = 'Success' " +
        "order by Payment_Date desc limit 50");

    out.put("ok", true);
    out.put("summary", summary);
    out.put("installments", installments);
    out.put("payments", payments);
    return out;
}


/* ----------------------------------------------------------------------------
 * portal.getAnnouncements - school-wide plus this child's section
 * -------------------------------------------------------------------------- */
list portal.getAnnouncements(string studentId)
{
    access = portal.assertStudentAccess(studentId);
    if(access.size() == 0)
    {
        return List();
    }
    today = zoho.currentdate.toString("yyyy-MM-dd");
    q = "select Title, Body, Publish_From, Audience from Announcements " +
        "where Is_Active = true and Publish_From <= '" + today + "' and Publish_To >= '" + today + "'";
    if(access.get("section").toString() != "")
    {
        q = q + " and (Audience = 'All' or Class_Section = " + access.get("section") + ")";
    }
    else
    {
        q = q + " and Audience = 'All'";
    }
    return portal.coql(q + " order by Publish_From desc limit 20");
}


/* ----------------------------------------------------------------------------
 * portal.coql - COQL against CRM from inside Creator.
 * Connection "crm_conn" (Zoho OAuth, scopes ZohoCRM.coql.READ +
 * ZohoCRM.modules.ALL) is owned by a dedicated integration user with read-only
 * profile access to the school modules - a portal bug can therefore never write
 * to CRM through this path.
 * -------------------------------------------------------------------------- */
list portal.coql(string query)
{
    payload = Map();
    payload.put("select_query", query);

    resp = invokeurl
    [
        url        : "https://www.zohoapis.in/crm/v5/coql"
        type       : POST
        parameters : payload.toString()
        headers    : {"Content-Type":"application/json"}
        connection : "crm_conn"
    ];

    out = List();
    if(!isNull(resp.get("data")))
    {
        out = resp.get("data").toList();
    }
    else if(!isNull(resp.get("code")) && resp.get("code") != "NO_CONTENT")
    {
        info "Portal COQL error: " + resp.toString();
    }
    return out;
}
