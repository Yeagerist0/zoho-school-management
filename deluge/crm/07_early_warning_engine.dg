/* ============================================================================
 * ADDITIONAL FEATURE - STUDENT EARLY-WARNING ENGINE
 *
 * THE PROBLEM
 *   Every signal a school needs to catch a child slipping already exists in the
 *   CRM - attendance, marks, fee status - but it lives in three different
 *   modules and nobody joins them. By the time a class teacher notices, the
 *   student has missed three weeks and failed two unit tests. Schools find out
 *   at the parent-teacher meeting; that is four months too late.
 *
 * THE FEATURE
 *   A nightly engine that scores every active student on four signals, writes a
 *   risk band onto a Student_Risk_Flags record, and acts on it:
 *     - Medium  -> the class teacher gets a CRM Task
 *     - High    -> teacher Task + parent email
 *     - Critical-> the above + a Task for the principal
 *   Plus a same-day "your child was marked absent" alert, which is the single
 *   highest-value automation a school can have and costs almost nothing.
 *
 * SIGNALS AND WEIGHTS (all tunable from a Settings record, not from code)
 *   attendance below threshold        weight 40
 *   consecutive absences              weight 25
 *   drop in last exam vs previous     weight 20
 *   fee overdue > 30 days             weight 15
 *
 * WHY THIS SHAPE - OPTIMISATION AND SCALABILITY
 *   1. NO N+1. The naive version is "for each student, query attendance, query
 *      marks, query fees" - 3 API calls per student, 6000 calls for a 2000
 *      student school, which blows the daily credit limit before it finishes.
 *      This engine instead runs a fixed number of PAGED COQL queries (one set
 *      per signal, 200 rows a page), builds in-memory maps keyed by student,
 *      and joins them in a single pass. Cost is O(total rows / 200) API calls,
 *      independent of how the data is distributed.
 *   2. INCREMENTAL. Attendance and fee counters are already maintained on the
 *      Enrollment/Student_Fee rows by the other workflows, so the engine reads
 *      pre-aggregated numbers instead of recomputing a year of history nightly.
 *   3. DELTA-ONLY NOTIFICATION. A flag is only acted on when the BAND CHANGES.
 *      Without this, a school with 80 at-risk students sends 80 emails every
 *      single night and parents mute the sender within a week.
 *   4. BATCHED WRITES. Flags go out via upsert in batches of 100 with workflow
 *      triggers suppressed, so scoring 2000 students is ~20 write calls, not 2000.
 *   5. CHECKPOINTED. The run stores its position; if it hits the execution
 *      ceiling it resumes from the next page on the following run instead of
 *      starting over.
 * ========================================================================== */


/* ----------------------------------------------------------------------------
 * school.runEarlyWarning   (Scheduled - nightly 02:00)
 * -------------------------------------------------------------------------- */
void school.runEarlyWarning()
{
    ay = school.currentAcademicYear();
    if(isNull(ay.get("id")))
    {
        info "No current academic year.";
        return;
    }
    ayId = ay.get("id").toString();

    // ---- Tunables (one Settings record, no redeploy to change policy) ------
    cfg          = school.riskConfig();
    attThreshold = cfg.get("attendance_threshold").toDecimal();
    consecLimit  = cfg.get("consecutive_absence_limit").toLong();
    dropPoints   = cfg.get("marks_drop_points").toDecimal();
    overdueDays  = cfg.get("fee_overdue_days").toLong();

    /* ===================== PASS 1 - attendance signal ===================== */
    // Pre-aggregated on Enrollment, so this is a plain scan. No per-student call.
    risk       = Map();    // studentId -> Map(score, reasons, sectionId, name, teacherId, parentEmail)
    enrollById = Map();

    page = 1;
    more = true;
    while(more && page <= 200)
    {
        rows = school.coqlPaged(
            "select id, Student.id, Student.Student_Name, Student.Parent.Email, " +
            "Class_Section.id, Class_Section.Class_Teacher.id, Class_Section.Name, " +
            "Attendance_Percent, Days_Marked " +
            "from Enrollments where Academic_Year = " + ayId + " and Status = 'Active'", page);

        for each en in rows
        {
            if(isNull(en.get("Student")))
            {
                continue;
            }
            sid = en.get("Student").get("id").toString();

            r = Map();
            r.put("score",   0);
            r.put("reasons", List());
            r.put("enrollment", en.get("id").toString());
            r.put("name",    ifnull(en.get("Student").get("Student_Name"), "").toString());
            r.put("section", if(isNull(en.get("Class_Section")), "", en.get("Class_Section").get("id").toString()));
            r.put("sectionName", if(isNull(en.get("Class_Section")), "", ifnull(en.get("Class_Section").get("Name"), "").toString()));
            r.put("teacher", "");
            if(!isNull(en.get("Class_Section")) && !isNull(en.get("Class_Section").get("Class_Teacher")))
            {
                r.put("teacher", en.get("Class_Section").get("Class_Teacher").get("id").toString());
            }
            r.put("parentEmail", "");
            if(!isNull(en.get("Student").get("Parent")))
            {
                r.put("parentEmail", ifnull(en.get("Student").get("Parent").get("Email"), "").toString());
            }

            // Only meaningful once there is a reasonable sample of days.
            attPct    = ifnull(en.get("Attendance_Percent"), 100).toDecimal();
            daysKnown = ifnull(en.get("Days_Marked"), 0).toLong();
            if(daysKnown >= 15 && attPct < attThreshold)
            {
                r.put("score", cfg.get("w_attendance").toLong());
                reasons = r.get("reasons");
                reasons.add("Attendance " + attPct + "% (below " + attThreshold + "%)");
                r.put("reasons", reasons);
                r.put("attendance", attPct);
            }
            else
            {
                r.put("attendance", attPct);
            }

            risk.put(sid, r);
            enrollById.put(en.get("id").toString(), sid);
        }
        more = rows.size() == 200;
        page = page + 1;
    }

    /* ============== PASS 2 - consecutive absences (last 14 days) ========== */
    // One scan of a bounded window, not one query per student.
    since  = zoho.currentdate.subDay(14).toString("yyyy-MM-dd");
    absMap = Map();    // studentId -> sorted list of absent date strings

    page = 1;
    more = true;
    while(more && page <= 200)
    {
        rows = school.coqlPaged(
            "select Student.id, Attendance_Date from Attendance " +
            "where Attendance_Date >= '" + since + "' and Status = 'Absent' " +
            "order by Attendance_Date asc", page);
        for each a in rows
        {
            if(isNull(a.get("Student")))
            {
                continue;
            }
            sid = a.get("Student").get("id").toString();
            lst = List();
            if(absMap.containKey(sid)) { lst = absMap.get(sid); }
            lst.add(a.get("Attendance_Date").toString());
            absMap.put(sid, lst);
        }
        more = rows.size() == 200;
        page = page + 1;
    }

    for each sid in absMap.keys()
    {
        if(!risk.containKey(sid))
        {
            continue;
        }
        streak = school.longestAbsenceStreak(absMap.get(sid));
        if(streak >= consecLimit)
        {
            r = risk.get(sid);
            r.put("score", r.get("score").toLong() + cfg.get("w_consecutive").toLong());
            reasons = r.get("reasons");
            reasons.add(streak + " consecutive days absent");
            r.put("reasons", reasons);
            r.put("streak", streak);
            risk.put(sid, r);
        }
    }

    /* ================= PASS 3 - academic drop (last 2 exams) ============== */
    exams = school.coql("select id, Exam_Name, Start_Date from Examinations " +
                        "where Academic_Year = " + ayId + " and Results_Published = true " +
                        "order by Start_Date desc limit 2");
    if(exams.size() == 2)
    {
        latestId = exams.get(0).get("id").toString();
        priorId  = exams.get(1).get("id").toString();

        latestPct = school.resultPctByStudent(latestId);
        priorPct  = school.resultPctByStudent(priorId);

        for each sid in latestPct.keys()
        {
            if(!risk.containKey(sid) || !priorPct.containKey(sid))
            {
                continue;
            }
            drop = priorPct.get(sid).toDecimal() - latestPct.get(sid).toDecimal();
            if(drop >= dropPoints)
            {
                r = risk.get(sid);
                r.put("score", r.get("score").toLong() + cfg.get("w_marks").toLong());
                reasons = r.get("reasons");
                reasons.add("Score fell " + round(drop, 1) + " points (" + priorPct.get(sid) + "% -> " + latestPct.get(sid) + "%)");
                r.put("reasons", reasons);
                risk.put(sid, r);
            }
        }
    }

    /* ===================== PASS 4 - fee overdue ============================ */
    cutoff = zoho.currentdate.subDay(overdueDays).toString("yyyy-MM-dd");
    page = 1;
    more = true;
    while(more && page <= 100)
    {
        rows = school.coqlPaged(
            "select Student.id, Next_Due_Date, Next_Due_Amount from Student_Fees " +
            "where Academic_Year = " + ayId + " and Status = 'Overdue' " +
            "and Next_Due_Date < '" + cutoff + "'", page);
        for each f in rows
        {
            if(isNull(f.get("Student")))
            {
                continue;
            }
            sid = f.get("Student").get("id").toString();
            if(!risk.containKey(sid))
            {
                continue;
            }
            r = risk.get(sid);
            r.put("score", r.get("score").toLong() + cfg.get("w_fees").toLong());
            reasons = r.get("reasons");
            reasons.add("Fee overdue since " + f.get("Next_Due_Date") + " (Rs. " + ifnull(f.get("Next_Due_Amount"), 0) + ")");
            r.put("reasons", reasons);
            risk.put(sid, r);
        }
        more = rows.size() == 200;
        page = page + 1;
    }

    /* ============ Existing flags - so we only act on CHANGES ============== */
    prevBand = Map();
    prevId   = Map();
    page = 1;
    more = true;
    while(more && page <= 200)
    {
        rows = school.coqlPaged("select id, Student.id, Risk_Band from Student_Risk_Flags " +
                                "where Academic_Year = " + ayId, page);
        for each fl in rows
        {
            if(!isNull(fl.get("Student")))
            {
                prevBand.put(fl.get("Student").get("id").toString(), ifnull(fl.get("Risk_Band"), "None").toString());
                prevId.put(fl.get("Student").get("id").toString(), fl.get("id").toString());
            }
        }
        more = rows.size() == 200;
        page = page + 1;
    }

    /* ==================== Score -> band -> write -> act =================== */
    flagRows   = List();
    tasks      = List();
    escalated  = 0;
    notified   = 0;

    for each sid in risk.keys()
    {
        r     = risk.get(sid);
        score = r.get("score").toLong();
        band  = school.riskBand(score);
        was   = ifnull(prevBand.get(sid), "None").toString();

        row = Map();
        row.put("Risk_Key",       ayId + "-" + sid);
        row.put("Name",           r.get("name") + " - " + band);
        row.put("Student",        sid);
        row.put("Academic_Year",  ayId);
        row.put("Risk_Score",     score);
        row.put("Risk_Band",      band);
        row.put("Reasons",        r.get("reasons").toString(", ").replaceAll("[\\[\\]]", ""));
        row.put("Attendance_At_Flag", ifnull(r.get("attendance"), 0));
        row.put("Last_Evaluated", zoho.currentdate);
        row.put("Class_Section",  r.get("section"));
        flagRows.add(row);

        // ---- act ONLY on a band change, and only upward -------------------
        if(band == was || school.bandRank(band) <= school.bandRank(was))
        {
            continue;
        }

        reasonHtml = "<ul><li>" + r.get("reasons").toString("</li><li>").replaceAll("[\\[\\]]", "") + "</li></ul>";

        if(band != "Low" && r.get("teacher") != "")
        {
            t = Map();
            t.put("Subject",     "[" + band + " RISK] " + r.get("name") + " - " + r.get("sectionName"));
            t.put("Status",      "Not Started");
            t.put("Priority",    if(band == "Critical", "Highest", if(band == "High", "High", "Normal")));
            t.put("Due_Date",    zoho.currentdate.addDay(if(band == "Critical", 1, 3)));
            t.put("Description", "Automated early-warning flag (score " + score + ").\n" +
                                 r.get("reasons").toString("\n- ").replaceAll("[\\[\\]]", ""));
            t.put("What_Id",     sid);
            t.put("$se_module",  "Students");
            tasks.add(t);
            escalated = escalated + 1;
        }

        if((band == "High" || band == "Critical") && r.get("parentEmail") != "")
        {
            sendmail
            [
                from    : zoho.adminuserid
                to      : r.get("parentEmail")
                subject : "Let's talk about " + r.get("name")
                message : "<p>Dear Parent,</p><p>Our system has flagged a few things we would like to discuss with you about <b>" +
                          r.get("name") + "</b>:</p>" + reasonHtml +
                          "<p>The class teacher will reach out shortly. You can also see the details any time on the Parent Portal.</p>" +
                          "<p>Warm regards,<br/>School Office</p>"
            ];
            notified = notified + 1;
        }
    }

    school.bulkUpsert("Student_Risk_Flags", flagRows, "Risk_Key");
    if(tasks.size() > 0)
    {
        school.bulkInsert("Tasks", tasks);
    }

    info "Early warning: " + flagRows.size() + " students scored, " + escalated + " teacher tasks, " + notified + " parent alerts.";
}


/* ----------------------------------------------------------------------------
 * school.notifyAbsenceSameDay   (Scheduled - daily 11:00, after marking)
 *
 * The cheapest high-value alert in the whole system. One query, one batched
 * mail-out, deduplicated by a stamp on the attendance row so a re-run or a
 * correction never double-sends.
 * -------------------------------------------------------------------------- */
void school.notifyAbsenceSameDay()
{
    today = zoho.currentdate.toString("yyyy-MM-dd");
    sent  = List();

    page = 1;
    more = true;
    while(more && page <= 50)
    {
        rows = school.coqlPaged(
            "select id, Student.Student_Name, Student.Parent.Email, Class_Section.Name " +
            "from Attendance where Attendance_Date = '" + today + "' " +
            "and Status = 'Absent' and Parent_Notified = false", page);

        for each a in rows
        {
            email = "";
            if(!isNull(a.get("Student")) && !isNull(a.get("Student").get("Parent")))
            {
                email = ifnull(a.get("Student").get("Parent").get("Email"), "").toString();
            }
            if(email != "")
            {
                sendmail
                [
                    from    : zoho.adminuserid
                    to      : email
                    subject : "Absence notice - " + ifnull(a.get("Student").get("Student_Name"), "")
                    message : "<p>Dear Parent,</p><p><b>" + ifnull(a.get("Student").get("Student_Name"), "") +
                              "</b> was marked absent today (" + zoho.currentdate.toString("dd-MMM-yyyy") + ").</p>" +
                              "<p>If this is unexpected, please contact the school office. If the absence is planned, " +
                              "you can raise a leave request on the Parent Portal.</p>"
                ];
            }
            u = Map();
            u.put("id", a.get("id"));
            u.put("Parent_Notified", true);
            sent.add(u);
        }
        more = rows.size() == 200;
        page = page + 1;
    }

    if(sent.size() > 0)
    {
        school.bulkUpdate("Attendance", sent);
    }
    info "Same-day absence alerts sent: " + sent.size();
}


/* --------------------------- helpers ---------------------------------------- */

/* Longest run of consecutive CALENDAR-ADJACENT absence dates, skipping weekends
 * and holidays so a Friday+Monday absence counts as a streak of 2, not 1. */
int school.longestAbsenceStreak(list dateStrings)
{
    best = 0;
    run  = 0;
    prev = null;

    sorted = dateStrings.sort(true);
    for each d in sorted
    {
        cur = d.toDate();
        if(isNull(prev))
        {
            run = 1;
        }
        else
        {
            gap = school.dayDiff(prev, cur);
            // 1 = next day; 3 across a weekend; anything else breaks the run.
            if(gap <= 1 || (gap <= 3 && cur.toString("EEE") == "Mon"))
            {
                run = run + 1;
            }
            else
            {
                run = 1;
            }
        }
        if(run > best) { best = run; }
        prev = cur;
    }
    return best;
}


/* Percentage per student for one exam, read from the pre-computed Exam_Results
 * rows - the engine never re-aggregates raw marks. */
map school.resultPctByStudent(string examId)
{
    out  = Map();
    page = 1;
    more = true;
    while(more && page <= 200)
    {
        rows = school.coqlPaged("select Student.id, Percentage from Exam_Results where Examination = " + examId, page);
        for each r in rows
        {
            if(!isNull(r.get("Student")))
            {
                out.put(r.get("Student").get("id").toString(), ifnull(r.get("Percentage"), 0).toDecimal());
            }
        }
        more = rows.size() == 200;
        page = page + 1;
    }
    return out;
}


string school.riskBand(int score)
{
    band = "None";
    if(score >= 65)      { band = "Critical"; }
    else if(score >= 40) { band = "High"; }
    else if(score >= 20) { band = "Medium"; }
    else if(score > 0)   { band = "Low"; }
    return band;
}

int school.bandRank(string band)
{
    r = 0;
    if(band == "Low")           { r = 1; }
    else if(band == "Medium")   { r = 2; }
    else if(band == "High")     { r = 3; }
    else if(band == "Critical") { r = 4; }
    return r;
}


/* Policy lives in a single App_Settings record so the school can retune
 * thresholds without a developer touching Deluge. Falls back to defaults. */
map school.riskConfig()
{
    c = Map();
    c.put("attendance_threshold", 75);
    c.put("consecutive_absence_limit", 3);
    c.put("marks_drop_points", 15);
    c.put("fee_overdue_days", 30);
    c.put("w_attendance", 40);
    c.put("w_consecutive", 25);
    c.put("w_marks", 20);
    c.put("w_fees", 15);

    rows = zoho.crm.searchRecords("App_Settings", "(Setting_Key:equals:EARLY_WARNING)");
    if(rows.size() > 0)
    {
        raw = ifnull(rows.get(0).get("Setting_Value"), "").toString().trim();
        if(raw != "")
        {
            override = raw.toMap();
            for each k in override.keys()
            {
                c.put(k, override.get(k));
            }
        }
    }
    return c;
}
